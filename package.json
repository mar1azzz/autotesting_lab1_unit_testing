{
  "name": "lab1_unit_testing",
  "version": "1.0.0",
  "description": "Unit testing practice with Mocha, Chai, ESLint, Husky, and c8 coverage",
  "type": "module",
  "scripts": {
    "test": "mocha --config .mocharc.json",
    "coverage": "c8 --reporter=text --reporter=lcov --reporter=html mocha --config .mocharc.json",
    "eslint": "eslint src test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/register": "^7.28.3",
    "@eslint/js": "^9.38.0",
    "babel-loader": "^9.1.4",
    "c8": "^10.1.3",
    "chai": "^6.2.0",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "mocha": "^11.7.4",
    "mochawesome": "^2.0.5",
    "prettier": "^3.6.2"
  }
}
